<UserControl x:Class="CsvImporter.WPF.Views.TableSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Continue">
    <Grid MaxWidth="1100" MaxHeight="700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="&#128427;  Ziel-Tabelle auswaehlen"
                       FontSize="28"
                       FontWeight="Bold" />
            <TextBlock Text="Waehlen Sie die Datenbank-Tabelle fuer den Import"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="14"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Selector row -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Tabelle" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="TablesCombo"
                          Grid.Column="0"
                          ItemsSource="{Binding Tables}"
                          SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                          FontSize="16"
                          IsTextSearchEnabled="True"
                          Padding="8,6"
                          AutomationProperties.Name="Ziel Tabelle" />

                <Button Grid.Column="1"
                        Content="Neu laden"
                        Command="{Binding LoadTablesCommand}"
                        Margin="10,0,0,0"
                        Padding="10,6"
                        AutomationProperties.Name="Tabellenliste neu laden"
                        Style="{StaticResource ButtonGhost}" />

                <Button Grid.Column="2"
                        Content="Kunden exportieren"
                        Command="{Binding ExportCommand}"
                        Margin="10,0,0,0"
                        Padding="10,6"
                        AutomationProperties.Name="Kunden exportieren"
                        Style="{StaticResource ButtonGhost}" />
            </Grid>
        </StackPanel>

        <!-- Status and errors -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="{Binding ConnectionInfo}"
                       Foreground="{StaticResource BrushTextMuted}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Aktuelle Verbindungsinformation" />

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Laedt Tabellen..."
                           Visibility="{Binding IsLoadingTables, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{StaticResource BrushTextMuted}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Laedt Schema..."
                           Visibility="{Binding IsLoadingSchema, Converter={StaticResource BoolToVisibility}}"
                           Foreground="{StaticResource BrushTextMuted}"
                           AutomationProperties.LiveSetting="Polite"
                           Margin="8,0,0,0" />
            </StackPanel>

            <Border Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                    Background="#22FF5D6E"
                    BorderBrush="{StaticResource BrushError}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushError}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Schema -->
        <Border Grid.Row="3"
                Style="{StaticResource Card}"
                Visibility="{Binding SchemaLoaded, Converter={StaticResource BoolToVisibility}}"
                Padding="12">
            <StackPanel>
                <TextBlock Text="&#128462;  Tabellen-Schema"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <ScrollViewer Height="300">
                    <ItemsControl ItemsSource="{Binding DbColumns}"
                                  AutomationProperties.Name="Schema Spaltenliste">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Background="{StaticResource BrushSurface}"
                                        Margin="0,0,0,10"
                                        Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                            <Border Margin="10,0,0,0"
                                                    Padding="6,2"
                                                    CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#22FF5D6E" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNullable}" Value="True">
                                                                <Setter Property="Background" Value="#1F3A5477" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Pflichtfeld" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNullable}" Value="True">
                                                                    <Setter Property="Text" Value="Optional" />
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Padding="8,3"
                                                CornerRadius="10"
                                                Background="{StaticResource BrushElevated}">
                                            <TextBlock Text="{Binding DataType}" FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
