<Application x:Class="CsvImporter.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CsvImporter.WPF.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:MappingStatusToColorConverter x:Key="MappingStatusToColor" />
            <conv:FileSizeConverter             x:Key="FileSize" />
            <conv:JobStatusToIconConverter      x:Key="JobStatusToIcon" />
            <conv:StrategyToLabelConverter      x:Key="StrategyToLabel" />
            <conv:ScoreToPercentConverter       x:Key="ScoreToPercent" />
            <conv:BoolToVisibilityConverter     x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter     x:Key="InvertBoolToVisibility" Invert="True" />
            <conv:EnumToBoolConverter           x:Key="EnumBoolConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
