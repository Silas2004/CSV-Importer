<Window x:Class="CsvImporter.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CsvImporter.WPF.ViewModels"
        xmlns:views="clr-namespace:CsvImporter.WPF.Views"
        Title="Daten Import Wizard" Height="860" Width="1600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TableSelectionViewModel}">
            <views:TableSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileSelectionViewModel}">
            <views:FileSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilePreviewViewModel}">
            <views:FilePreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MappingViewModel}">
            <views:MappingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportProgressViewModel}">
            <views:ImportProgressView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BrushBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hero header -->
        <Grid Grid.Row="0" Margin="0,22,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource BrushBorder}"
                       StrokeDashArray="8,7" Stroke="{StaticResource BrushBorder}"
                       VerticalAlignment="Top" Margin="0,16,24,0" />

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" MinWidth="900">
                <TextBlock Text="Daten Import Wizard"
                           FontSize="56"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushText}" />
                <TextBlock Text="Importieren Sie Ihre Daten sicher und strukturiert"
                           Margin="0,8,0,0"
                           FontSize="40"
                           Foreground="{StaticResource BrushTextMuted}" />
            </StackPanel>

            <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource BrushBorder}"
                       StrokeDashArray="8,7" Stroke="{StaticResource BrushBorder}"
                       VerticalAlignment="Top" Margin="24,16,0,0" />
        </Grid>

        <!-- Stepper card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="96,28,96,0" Padding="34,28">
            <Grid>
                <Rectangle Height="5" RadiusX="2" RadiusY="2"
                           Fill="{StaticResource BrushBorder}"
                           HorizontalAlignment="Stretch" VerticalAlignment="Top"
                           Margin="8,26,8,0" />

                <UniformGrid Rows="1" Columns="8" Margin="0,0,0,0">
                    <!-- 1 Einstellungen -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                                </Style>
                            </Border.Style>
                            <TextBlock Text="⚙" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <TextBlock Text="Einstellungen" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 2 Tabelle -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BrushElevated}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="🗄" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock Text="Tabelle" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 3 Datei -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BrushElevated}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="⇪" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock Text="Datei" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 4 Vorschau -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BrushElevated}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="◉" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock Text="Vorschau" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 5 Mapping -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BrushElevated}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock Text="Mapping" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 6 Validierung -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" BorderThickness="1" Background="{StaticResource BrushElevated}" BorderBrush="{StaticResource BrushBorder}">
                            <TextBlock Text="✓" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock Text="Validierung" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 7 Import -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BrushElevated}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="◔" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock Text="Import" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 8 Fertig -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" BorderThickness="1" Background="{StaticResource BrushElevated}" BorderBrush="{StaticResource BrushBorder}">
                            <TextBlock Text="✓✓" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock Text="Fertig" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Step content -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="96,30,96,20" Padding="26">
            <ContentControl Content="{Binding CurrentStepViewModel}" />
        </Border>

        <!-- Bottom navigation -->
        <Border Grid.Row="3" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="⚙ Einstellungen"
                        Style="{StaticResource ButtonGhost}"
                        HorizontalAlignment="Left"
                        Padding="18,8"
                        Click="OpenSettings_Click" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="← Zurück"
                            Command="{Binding BackCommand}"
                            Padding="18,8" Margin="0,0,10,0"
                            Style="{StaticResource ButtonGhost}" />
                    <Button Content="Weiter →"
                            Command="{Binding NextCommand}"
                            Padding="18,8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
