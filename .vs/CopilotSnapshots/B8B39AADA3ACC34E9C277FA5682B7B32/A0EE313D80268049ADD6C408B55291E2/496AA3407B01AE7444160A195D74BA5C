<Window x:Class="CsvImporter.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CsvImporter.WPF.ViewModels"
        xmlns:views="clr-namespace:CsvImporter.WPF.Views"
        Title="CSV Importer" Height="700" Width="1060"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TableSelectionViewModel}">
            <views:TableSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileSelectionViewModel}">
            <views:FileSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilePreviewViewModel}">
            <views:FilePreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MappingViewModel}">
            <views:MappingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportProgressViewModel}">
            <views:ImportProgressView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BrushBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header bar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App name -->
                <TextBlock Grid.Column="0" Text="CSV Importer"
                           FontSize="{StaticResource FontSm}"
                           Foreground="{StaticResource BrushTextMuted}"
                           VerticalAlignment="Center" />

                <!-- Step indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                    <TextBlock Text="1. Tabelle">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="&#8250;" Style="{StaticResource StepLabel}" />

                    <TextBlock Text="2. Dateien">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="&#8250;" Style="{StaticResource StepLabel}" />

                    <TextBlock Text="3. Vorschau">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="&#8250;" Style="{StaticResource StepLabel}" />

                    <TextBlock Text="4. Mapping">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="&#8250;" Style="{StaticResource StepLabel}" />

                    <TextBlock Text="5. Import">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StepLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </StackPanel>

                <!-- Settings gear -->
                <Button Grid.Column="2" Content="&#9881;"
                        Style="{StaticResource ButtonIcon}"
                        Padding="10,6"
                        ToolTip="Verbindungseinstellungen"
                        Click="OpenSettings_Click" />
            </Grid>
        </Border>

        <!-- ── Step content ────────────────────────────────────────────────── -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentStepViewModel}"
                        Margin="20,16" />

        <!-- ── Navigation ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#8592; Zur&#252;ck"
                        Command="{Binding BackCommand}"
                        Padding="16,7" Margin="0,0,8,0"
                        Style="{StaticResource ButtonGhost}" />
                <Button Content="Weiter &#8594;"
                        Command="{Binding NextCommand}"
                        Padding="16,7" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
