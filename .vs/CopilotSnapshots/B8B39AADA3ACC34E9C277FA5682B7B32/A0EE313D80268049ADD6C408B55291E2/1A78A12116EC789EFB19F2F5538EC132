<Window x:Class="CsvImporter.WPF.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CsvImporter.WPF.Views"
        Title="Verbindungseinstellungen"
        Height="540" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ConnectionView embedded directly -->
        <views:ConnectionView Grid.Row="0" />

        <!-- Footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <TextBlock Text="Profil wird beim Schlie&#223;en als aktive Verbindung gesetzt."
                       Foreground="{StaticResource BrushTextMuted}"
                       VerticalAlignment="Center" Margin="0,0,16,0"
                       FontSize="{StaticResource FontSm}" />
            <Button Content="Schlie&#223;en" Click="CloseButton_Click" Padding="16,6" />
        </StackPanel>
    </Grid>
</Window>

