<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ════════════════════════ BASE COLORS ════════════════════════════════ -->
    <Color x:Key="ColorBgBase">#FF1E1E1E</Color>
    <Color x:Key="ColorBgSurface">#FF252526</Color>
    <Color x:Key="ColorBgPanel">#FF2D2D30</Color>
    <Color x:Key="ColorBgElevated">#FF37373D</Color>
    <Color x:Key="ColorBgInput">#FF3C3C3C</Color>

    <Color x:Key="ColorBorder">#FF404040</Color>
    <Color x:Key="ColorBorderFocus">#FF007ACC</Color>
    <Color x:Key="ColorBorderSubtle">#FF2D2D30</Color>

    <Color x:Key="ColorTextPrimary">#FFD4D4D4</Color>
    <Color x:Key="ColorTextSecondary">#FF9D9D9D</Color>
    <Color x:Key="ColorTextDisabled">#FF6B6B6B</Color>

    <Color x:Key="ColorAccent">#FF0E639C</Color>
    <Color x:Key="ColorAccentHover">#FF1177BB</Color>
    <Color x:Key="ColorAccentPressed">#FF0D4A7A</Color>
    <Color x:Key="ColorAccentSoft">#1A0E639C</Color>

    <Color x:Key="ColorSuccess">#FF4EC9B0</Color>
    <Color x:Key="ColorWarning">#FFDCDCAA</Color>
    <Color x:Key="ColorError">#FFF44747</Color>
    <Color x:Key="ColorErrorSoft">#1AF44747</Color>

    <Color x:Key="ColorRowHover">#FF2A2D2E</Color>
    <Color x:Key="ColorRowSelected">#FF04395E</Color>

    <!-- ════════════════════════ BRUSHES ════════════════════════════════════ -->
    <SolidColorBrush x:Key="BrushBg"             Color="{StaticResource ColorBgBase}" />
    <SolidColorBrush x:Key="BrushSurface"        Color="{StaticResource ColorBgSurface}" />
    <SolidColorBrush x:Key="BrushPanel"          Color="{StaticResource ColorBgPanel}" />
    <SolidColorBrush x:Key="BrushElevated"       Color="{StaticResource ColorBgElevated}" />
    <SolidColorBrush x:Key="BrushInput"          Color="{StaticResource ColorBgInput}" />
    <SolidColorBrush x:Key="BrushBorder"         Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderFocus"    Color="{StaticResource ColorBorderFocus}" />
    <SolidColorBrush x:Key="BrushBorderSubtle"   Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushText"           Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextMuted"      Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextDisabled"   Color="{StaticResource ColorTextDisabled}" />
    <SolidColorBrush x:Key="BrushAccent"         Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover"    Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushAccentPressed"  Color="{StaticResource ColorAccentPressed}" />
    <SolidColorBrush x:Key="BrushSuccess"        Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning"        Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushError"          Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="BrushRowHover"       Color="{StaticResource ColorRowHover}" />
    <SolidColorBrush x:Key="BrushRowSelected"    Color="{StaticResource ColorRowSelected}" />
    <SolidColorBrush x:Key="BrushTransparent"    Color="Transparent" />

    <!-- ════════════════════════ TYPOGRAPHY ════════════════════════════════ -->
    <FontFamily x:Key="FontSans">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas</FontFamily>
    <sys:Double x:Key="FontSm">11</sys:Double>
    <sys:Double x:Key="FontBase">13</sys:Double>
    <sys:Double x:Key="FontMd">15</sys:Double>
    <sys:Double x:Key="FontH">20</sys:Double>

    <!-- ════════════════════════ SPACING HELPERS ═══════════════════════════ -->
    <Thickness x:Key="PaddingInput">10,7</Thickness>
    <Thickness x:Key="PaddingCard">16</Thickness>
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>

</ResourceDictionary>
