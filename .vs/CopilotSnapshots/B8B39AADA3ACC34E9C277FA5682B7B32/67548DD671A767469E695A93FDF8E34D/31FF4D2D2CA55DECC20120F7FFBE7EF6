<UserControl x:Class="CsvImporter.WPF.Views.FileSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Continue">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="&#8679;  Datei hochladen"
                       FontSize="44"
                       FontWeight="Bold" />
            <TextBlock Text="CSV, Excel oder JSON-Datei auswaehlen"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="20"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Drop area visual -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Background="{StaticResource BrushSurface}"
                Padding="20"
                Margin="0,0,0,14">
            <Grid Height="240">
                <Border BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Background="#10000000">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#8679;" FontSize="56" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="Datei hier ablegen oder auswaehlen"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                        <TextBlock Text="Unterstuetzte Formate: CSV, XLSX, JSON (max. 50MB)"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="_Dateien waehlen"
                                    Command="{Binding AddFilesCommand}"
                                    AutomationProperties.Name="Dateien auswaehlen"
                                    Padding="14,8"
                                    Margin="0,0,8,0" />
                            <Button Content="_Ordner waehlen"
                                    Command="{Binding AddFolderCommand}"
                                    AutomationProperties.Name="Ordner auswaehlen"
                                    Padding="14,8"
                                    Style="{StaticResource ButtonGhost}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Parsing options -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Trennzeichen" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1"
                     Text="{Binding DelimiterText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Trennzeichen"
                     MaxLength="1" />

            <TextBlock Grid.Column="3" Text="Kodierung" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="4"
                      AutomationProperties.Name="Zeichenkodierung"
                      SelectedValue="{Binding EncodingName, Mode=TwoWay}"
                      SelectedValuePath="Content">
                <ComboBoxItem Content="UTF-8" />
                <ComboBoxItem Content="iso-8859-1" />
                <ComboBoxItem Content="windows-1252" />
            </ComboBox>
        </Grid>

        <!-- Selected files -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Ausgewaehlte Dateien"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="14,12,14,8" />

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding SelectedFiles}"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="Liste ausgewaehlter Dateien"
                         Margin="12,0,12,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                <Button Grid.Column="1"
                                        Content="&#10005;"
                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Datei aus Liste entfernen"
                                        Style="{StaticResource ButtonIcon}"
                                        Padding="8,4" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Text="{Binding TotalSummary}"
                           Foreground="{StaticResource BrushTextMuted}"
                           Margin="14,10,14,12" />
            </Grid>
        </Border>
    </Grid>
</UserControl>


