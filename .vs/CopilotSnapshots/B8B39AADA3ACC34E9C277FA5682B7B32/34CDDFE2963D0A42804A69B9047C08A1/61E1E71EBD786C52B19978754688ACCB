<Window x:Class="CsvImporter.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CsvImporter.WPF.ViewModels"
        xmlns:views="clr-namespace:CsvImporter.WPF.Views"
        Title="Daten Import Wizard"
        Height="860"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#030B20">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TableSelectionViewModel}">
            <views:TableSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileSelectionViewModel}">
            <views:FileSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilePreviewViewModel}">
            <views:FilePreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MappingViewModel}">
            <views:MappingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportProgressViewModel}">
            <views:ImportProgressView />
        </DataTemplate>

        <LinearGradientBrush x:Key="WizardBgGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#040B21" Offset="0" />
            <GradientStop Color="#061337" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0D1C42" Offset="0" />
            <GradientStop Color="#0A1739" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="StepBubble" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Background" Value="#1B2E4E" />
            <Setter Property="BorderBrush" Value="#2D486F" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="StepLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FB2D4" />
            <Setter Property="FontSize" Value="31" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WizardBgGradient}"
          KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.DirectionalNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="30,18,30,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Daten Import Wizard"
                           FontSize="58"
                           FontWeight="Bold"
                           Foreground="#EFF4FF" />
                <TextBlock Text="Importieren Sie Ihre Daten sicher und strukturiert"
                           Margin="0,4,0,0"
                           Foreground="#A9BADC"
                           FontSize="20" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="&#9881;"
                    Style="{StaticResource ButtonIcon}"
                    Width="40"
                    Height="40"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top"
                    ToolTip="Verbindungseinstellungen"
                    AutomationProperties.Name="Verbindungseinstellungen oeffnen"
                    Click="OpenSettings_Click" />
        </Grid>

        <!-- Stepper Card -->
        <Border Grid.Row="1"
                Margin="30,16,30,0"
                Padding="28,24"
                Background="{StaticResource PanelGradient}"
                BorderBrush="#2A466E"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Rectangle Height="4"
                           Fill="#355176"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           Margin="12,26,12,0" />

                <UniformGrid Rows="1" Columns="8">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Style="{StaticResource StepBubble}" Background="#14A8FF" BorderBrush="#35BAFF" BorderThickness="2">
                            <TextBlock Text="&#10003;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <TextBlock Text="Einstellungen" Style="{StaticResource StepLabelText}" Foreground="#EFF4FF" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBubble}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#128427;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D7E6FF" />
                        </Border>
                        <TextBlock Text="Tabelle" Style="{StaticResource StepLabelText}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBubble}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#8679;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D7E6FF" />
                        </Border>
                        <TextBlock Text="Datei" Style="{StaticResource StepLabelText}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBubble}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#9716;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D7E6FF" />
                        </Border>
                        <TextBlock Text="Vorschau" Style="{StaticResource StepLabelText}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBubble}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#128462;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D7E6FF" />
                        </Border>
                        <TextBlock Text="Mapping" Style="{StaticResource StepLabelText}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <Border Style="{StaticResource StepBubble}">
                            <TextBlock Text="&#10003;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9FB2D4" />
                        </Border>
                        <TextBlock Text="Validierung" Style="{StaticResource StepLabelText}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StepBubble}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                            <Setter Property="Background" Value="#14A8FF" />
                                            <Setter Property="BorderBrush" Value="#35BAFF" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#9711;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D7E6FF" />
                        </Border>
                        <TextBlock Text="Import" Style="{StaticResource StepLabelText}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center">
                        <Border Style="{StaticResource StepBubble}">
                            <TextBlock Text="&#10003;&#10003;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9FB2D4" />
                        </Border>
                        <TextBlock Text="Fertig" Style="{StaticResource StepLabelText}" />
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Content Card -->
        <Border Grid.Row="2"
                Margin="30,28,30,20"
                Padding="24"
                Background="{StaticResource PanelGradient}"
                BorderBrush="#2A466E"
                BorderThickness="1"
                CornerRadius="14">
            <ContentControl Content="{Binding CurrentStepViewModel}"
                            AutomationProperties.Name="Aktueller Schrittinhalt" />
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="#0A1739"
                BorderBrush="#2A466E"
                BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#8592; _Zurueck"
                            Command="{Binding BackCommand}"
                            Padding="18,8"
                            Margin="0,0,10,0"
                            AutomationProperties.Name="Zum vorherigen Schritt"
                            Style="{StaticResource ButtonGhost}" />
                    <Button Content="_Weiter &#8594;"
                            Command="{Binding NextCommand}"
                            IsDefault="True"
                            AutomationProperties.Name="Zum naechsten Schritt"
                            Padding="18,8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
