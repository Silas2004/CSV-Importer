<Window x:Class="CsvImporter.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CsvImporter.WPF.ViewModels"
        xmlns:views="clr-namespace:CsvImporter.WPF.Views"
        Title="Daten Import Wizard" Height="860" Width="1600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TableSelectionViewModel}">
            <views:TableSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileSelectionViewModel}">
            <views:FileSelectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilePreviewViewModel}">
            <views:FilePreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MappingViewModel}">
            <views:MappingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportProgressViewModel}">
            <views:ImportProgressView />
        </DataTemplate>

        <Style x:Key="StepBubble" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Background" Value="{StaticResource BrushElevated}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BrushBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="30,22,30,4">
            <StackPanel>
                <TextBlock Text="Daten Import Wizard" FontSize="60" FontWeight="Bold" />
                <TextBlock Text="Importieren Sie Ihre Daten sicher und strukturiert"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="20" />
            </StackPanel>
        </Grid>

        <!-- Stepper -->
        <Border Grid.Row="1" Margin="30,18,30,0" Padding="28,24">
            <Grid>
                <Rectangle Height="4"
                           Fill="{StaticResource BrushBorder}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           Margin="16,26,16,0" />

                <UniformGrid Rows="1" Columns="8">
                    <!-- Einstellungen -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Style="{StaticResource StepBubble}" Background="{StaticResource BrushAccent}" BorderBrush="{StaticResource BrushAccentHover}" BorderThickness="2">
                            <TextBlock Text="&#10003;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <TextBlock Text="Einstellungen" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Tabelle -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border x:Name="StepTable" Style="{StaticResource StepBubble}">
                            <TextBlock Text="&#128427;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock x:Name="StepTableLabel" Text="Tabelle" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <!-- Datei -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border x:Name="StepFile" Style="{StaticResource StepBubble}">
                            <TextBlock Text="&#8679;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock x:Name="StepFileLabel" Text="Datei" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <!-- Vorschau -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border x:Name="StepPreview" Style="{StaticResource StepBubble}">
                            <TextBlock Text="&#9716;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock x:Name="StepPreviewLabel" Text="Vorschau" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <!-- Mapping -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border x:Name="StepMapping" Style="{StaticResource StepBubble}">
                            <TextBlock Text="&#128462;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock x:Name="StepMappingLabel" Text="Mapping" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <!-- Validierung -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Style="{StaticResource StepBubble}">
                            <TextBlock Text="&#10003;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock Text="Validierung" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <!-- Import -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border x:Name="StepImport" Style="{StaticResource StepBubble}">
                            <TextBlock Text="&#9711;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock x:Name="StepImportLabel" Text="Import" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>

                    <!-- Fertig -->
                    <StackPanel HorizontalAlignment="Center">
                        <Border Style="{StaticResource StepBubble}">
                            <TextBlock Text="&#10003;&#10003;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                        </Border>
                        <TextBlock Text="Fertig" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </UniformGrid>
            </Grid>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                            <Setter TargetName="StepTable" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepTable" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepTable" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                            <Setter TargetName="StepTable" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepTable" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepFile" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepFile" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepFile" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                            <Setter TargetName="StepTable" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepTable" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepFile" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepFile" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepPreview" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepPreview" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepPreview" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                            <Setter TargetName="StepTable" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepTable" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepFile" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepFile" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepPreview" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepPreview" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepMapping" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepMapping" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepMapping" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                            <Setter TargetName="StepTable" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepTable" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepFile" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepFile" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepPreview" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepPreview" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepMapping" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepMapping" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepImport" Property="Background" Value="{StaticResource BrushAccent}" />
                            <Setter TargetName="StepImport" Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
                            <Setter TargetName="StepImport" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Step content card -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="30,30,30,20" Padding="26">
            <ContentControl Content="{Binding CurrentStepViewModel}" />
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource BrushPanel}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Einstellungen"
                        Style="{StaticResource ButtonGhost}"
                        HorizontalAlignment="Left"
                        Padding="18,8"
                        Click="OpenSettings_Click" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#8592; Zurueck"
                            Command="{Binding BackCommand}"
                            Padding="18,8" Margin="0,0,10,0"
                            Style="{StaticResource ButtonGhost}" />
                    <Button Content="Weiter &#8594;"
                            Command="{Binding NextCommand}"
                            Padding="18,8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
